# Copy to .env.local and fill in for local overrides.
# Only VITE_-prefixed variables reach the browser bundle — never put secrets here.

# Public origin the app is served from (no trailing slash).
VITE_SITE_URL=http://localhost:5173

# Optional analytics property id. Leave blank to disable.
VITE_ANALYTICS_ID=G-4C1PP726EZ

# Cloudflare R2 / External Model Hosting
# Cloudflare Workers enforce a 25 MiB asset limit. Large ONNX models (>25 MiB, e.g. LaMa at 198 MiB)
# are stored in an R2 bucket and delivered via a public R2.dev URL or custom CDN domain.
#
# Option 1: Base URL for all models (models are requested as ${VITE_MODELS_BASE_URL}/models/<file>)
# VITE_MODELS_BASE_URL=https://models.webtoolocean.com
#
# Option 2: Direct public URL for specific models
# VITE_LAMA_MODEL_URL=https://pub-your-bucket-id.r2.dev/models/lama_fp32.onnx
# VITE_UPSCALER_MODEL_URL=https://pub-your-bucket-id.r2.dev/models/realesr-general-x4v3.onnx

